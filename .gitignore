# State lives in the azurerm remote backend (sttokenfactorytfstate001) — never commit it
*.tfstate
*.tfstate.*

# Keys / certs / credentials
*.pem
*.p12
*.csr
*.key
*.srl
cert-base64.txt
jumphost_azure_login.txt

# Local scratch copies
*.bak
*.bkptf
*.pre-*
